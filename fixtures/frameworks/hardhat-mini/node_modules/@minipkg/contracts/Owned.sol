pragma solidity ^0.8.20;

/// @notice Stand-in for an npm-installed dependency under node_modules/.
abstract contract Owned {
    address public owner;

    constructor() {
        owner = msg.sender;
    }

    modifier onlyOwner() {
        require(msg.sender == owner, "not owner");
        _;
    }
}
